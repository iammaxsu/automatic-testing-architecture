# Default: detect text vs binary, normalize text to LF in the repository
* text=auto eol=lf

# Files that MUST be LF (break otherwise — bash refuses CRLF shebangs,
# Python on Linux gets confused, YAML parsers complain)
*.sh    text eol=lf
*.bash  text eol=lf
*.py    text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.toml  text eol=lf
*.ini   text eol=lf
*.conf  text eol=lf
Makefile text eol=lf

# Windows-only files: keep CRLF (.bat / .cmd actually want CRLF on Windows)
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Binary: never touch line endings
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.pdf   binary
*.zip   binary
*.tar.gz binary
*.gz    binary
*.xlsx  binary
*.xls   binary
*.docx  binary
